"""Luban-Lite Display Lab 构建入口。

作为应用（PRJ_APP 等于本目录名）：工具开关来自本目录的 Kconfig，另编译 main.c。
作为组件（另一个应用的 SConscript 用相对路径调用本文件）：宿主菜单里没有本目录的 Kconfig，按 SDK
已启用的能力编译全部工具；环境变量 DISPLAY_LAB_TESTCARD_EXTRA 给出色卡追加预置色。
"""
from building import *
import io
import os

Import('AIC_ROOT')
cwd = GetCurrentDir()
standalone = os.path.basename(cwd) == os.environ.get('PRJ_APP', '')


def config_string(symbol):
    """SCons 预处理器给出的字符串宏带引号；未定义返回空串。"""
    try:
        value = GetConfigValue(symbol)
    except KeyError:
        return ''
    value = str(value).strip()
    return value[1:-1] if len(value) >= 2 and value[0] == value[-1] == '"' else value


mpp = GetDepend('LPKG_MPP')
lvgl = mpp and GetDepend('LPKG_USING_LVGL') and GetDepend('LVGL_V_9')
if standalone:
    color = GetDepend('AIC_DISPLAY_LAB_COLOR')
    testcard = GetDepend('AIC_DISPLAY_LAB_TESTCARD')
    bench = GetDepend('AIC_DISPLAY_LAB_BENCH')
    extra = config_string('AIC_DISPLAY_LAB_TESTCARD_EXTRA')
else:
    color = mpp
    testcard = bench = lvgl
    extra = os.environ.get('DISPLAY_LAB_TESTCARD_EXTRA', '')

# 追加预置色只允许十六进制与空白，直接写进生成的 C 字符串，不做转义。
if any(c not in '0123456789abcdefABCDEFxX \t' for c in extra):
    raise ValueError('Display Lab test-card presets must be RRGGBB hex values: ' + extra)

src = []
defines = []
if color:
    src += Glob('src/color.c') + Glob('src/gamma.c') + Glob('src/ccm.c')
if testcard:
    src += Glob('src/testcard.c') + Glob('src/testcard_shell.c')
    defines.append('DLAB_TESTCARD')
if bench:
    src += Glob('src/display_bench.c')
    defines.append('DLAB_BENCH')
options = {}
if testcard or bench:
    # LVGL 线程第一次进入 lv_timer_handler() 时挂上 LVGL 侧的工具，见 src/display_lab.c。
    # 前导空格：SDK 的 LINKFLAGS 是字符串，直接拼接。
    src += Glob('src/display_lab.c')
    options['LINKFLAGS'] = ' -Wl,--wrap=lv_timer_handler'
if standalone:
    src += Glob('main.c')

prj_name = os.environ.get('PRJ_NAME') or Env['PRJ_NAME']
generated = os.path.join(AIC_ROOT, 'output', prj_name, 'display-lab')
if not os.path.isdir(generated):
    os.makedirs(generated)
header = u'/* generated by luban-lite-display-lab/SConscript */\n#define DLAB_TESTCARD_EXTRA "%s"\n' % extra
header_path = os.path.join(generated, 'dlab_config.h')
if not os.path.isfile(header_path) or io.open(header_path, encoding='utf-8').read() != header:
    with io.open(header_path, 'w', encoding='utf-8', newline=u'\n') as stream:
        stream.write(header)

tools = [name for name, on in (('hmi_color', color), ('hmi_testcard', testcard), ('hmi_display', bench)) if on]
print('Display Lab   : ' + (' '.join(tools) if tools else 'no tool enabled') +
      (' (application)' if standalone else ' (component)'))

group = DefineGroup('DISPLAY-LAB', src, depend=[''],
                    LOCAL_CPPPATH=[os.path.join(cwd, 'src'), generated],
                    LOCAL_CPPDEFINES=defines, **options)
Return('group')
